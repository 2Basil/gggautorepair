DATABASE_URL="file:./dev.db"
SESSION_SECRET="change-this-to-a-long-random-string-before-going-live"
# Share this code with someone to let them create an Owner account at /owner-join
OWNER_ACCESS_CODE="garage-owner-2026"
# Initial owner created by `npm run seed`
OWNER_EMAIL="owner.ZZZ@autorepairs.com"
OWNER_PASSWORD="ownerZZZ123"  # first-time password only; change it in Owner portal > Settings
# Set to true when serving over HTTPS
COOKIE_SECURE="false"

# Verification code at registration.
#   email  (default) free email codes - needs the EMAIL_* settings below
#   twilio           paid SMS (TWILIO_* below)      console  demo only (code shown on screen in dev)
OTP_PROVIDER="email"
# Free option: Brevo (300 emails/day). Create an account, verify a sender email, then SMTP & API > API keys.
EMAIL_PROVIDER="brevo"
EMAIL_API_KEY=""
EMAIL_FROM="your-verified-sender@example.com"
EMAIL_FROM_NAME="ZZZ AUTO REPAIR"
# Resend instead: EMAIL_PROVIDER="resend" (free tier needs a verified domain to email other people)
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_VERIFY_SID=""
# DEMO ONLY: shows the code on screen even in production (anyone could verify any email). Remove for real use.
# OTP_SHOW_CODE="true"

# Public site address used in shared bill links (optional; detected automatically)
# APP_URL="https://your-site.vercel.app"
