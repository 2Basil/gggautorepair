// ZZZ AUTO REPAIR — database schema (SQLite via Prisma)
// Enums are stored as plain strings (see lib/config.js) so the schema works on SQLite and Postgres alike.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  phone         String
  phoneVerified Boolean        @default(false)
  empId         String?        @unique // login ID for staff (role EMPLOYEE)
  userCode      String?        @unique // public customer ID, e.g. ZZZ-AAR-4321-K7
  address       String?
  city          String?
  passwordHash  String
  role          String         @default("CUSTOMER") // CUSTOMER | OWNER
  createdAt     DateTime       @default(now())
  vehicles      Vehicle[]
  jobs          Job[]
  bills         Bill[]
  subscriptions Subscription[]
}

model Vehicle {
  id            Int            @id @default(autoincrement())
  userId        Int
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  regNo         String         @unique
  make          String
  model         String
  year          Int
  type          String         @default("HATCHBACK") // HATCHBACK | SEDAN | SUV | LUXURY
  fuel          String         @default("PETROL")
  color         String?
  odometer      Int            @default(0)
  createdAt     DateTime       @default(now())
  jobs          Job[]
  bills         Bill[]
  subscriptions Subscription[]

  @@index([userId])
}

model Service {
  id          Int     @id @default(autoincrement())
  name        String
  category    String // Repairing | Washing | Modification | Maintenance
  description String
  basePrice   Int // USD, for a hatchback
  keywords    String // comma separated, used by the estimate engine
  prices      ServicePrice[]
  active      Boolean @default(true)
}

model Plan {
  id            Int            @id @default(autoincrement())
  tier          String // SHINE | CARE | ELITE
  name          String
  period        String // MONTHLY | YEARLY
  price         Int
  perks         String // newline separated
  popular       Boolean        @default(false)
  subscriptions Subscription[]

  @@unique([tier, period])
}

model Subscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId Int
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  planId    Int
  plan      Plan     @relation(fields: [planId], references: [id])
  status    String   @default("ACTIVE")
  startsAt  DateTime @default(now())
  endsAt    DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([vehicleId])
}

model Job {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId Int
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  query     String
  estMin    Int
  estMax    Int
  status    String    @default("BOOKED") // BOOKED | REPAIRING | REPAIRED | TESTING | READY | DELIVERED | CANCELLED
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  items     JobItem[]
  logs      JobLog[]
  bills     Bill[]

  @@index([userId])
  @@index([vehicleId])
}

model JobItem {
  id          Int    @id @default(autoincrement())
  jobId       Int
  job         Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  description String
  category    String @default("Repairing")
  qty         Int    @default(1)
  unitPrice   Int
}

model JobLog {
  id        Int      @id @default(autoincrement())
  jobId     Int
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  createdAt DateTime @default(now())
}

model Bill {
  id        Int        @id @default(autoincrement())
  number    String     @unique
  userId    Int
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId Int
  vehicle   Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  jobId     Int?
  job       Job?       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  subtotal  Int
  discount  Int        @default(0)
  taxPct    Int        @default(18)
  tax       Int
  total     Int
  paid      Boolean    @default(false)
  notes     String?
  createdAt DateTime   @default(now())
  items     BillItem[]
  samples   PriceSample[]

  @@index([userId])
  @@index([vehicleId])
}

model BillItem {
  id          Int    @id @default(autoincrement())
  billId      Int
  bill        Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)
  description String
  category    String @default("Repairing")
  qty         Int    @default(1)
  unitPrice   Int
}

// One row per bill line item. The price estimator learns from these (see lib/pricing.js).
model PriceSample {
  id          Int      @id @default(autoincrement())
  billId      Int?
  bill        Bill?    @relation(fields: [billId], references: [id], onDelete: Cascade)
  jobId       Int?
  description String
  category    String   @default("Repairing")
  make        String
  model       String
  vehicleType String
  year        Int
  fuel        String   @default("PETROL")
  queryText   String   @default("") // what the customer wrote (empty for walk-in bills)
  unitPrice   Int
  qty         Int      @default(1)
  active      Boolean  @default(true) // owner can switch a sample off
  createdAt   DateTime @default(now())

  @@index([description])
  @@index([make, model])
}

// One row per OTP request (rate limiting + the code hash when we send it ourselves).
model PhoneOtp {
  id         Int       @id @default(autoincrement())
  phone      String
  codeHash   String?
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

// Owner-set price of a service for one vehicle type (shown to customers on the home page).
model ServicePrice {
  id          Int      @id @default(autoincrement())
  serviceId   Int
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  vehicleType String
  price       Int
  updatedAt   DateTime @default(now())

  @@unique([serviceId, vehicleType])
}
