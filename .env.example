DATABASE_URL="file:./dev.db"
# REQUIRED in production: 16+ random characters (e.g. run: openssl rand -hex 32)
SESSION_SECRET="change-this-to-a-long-random-string-before-going-live"
# Share this code with someone to let them create an Owner account at /owner-join
OWNER_ACCESS_CODE="garage-owner-2026"
# Initial owner created by `npm run seed`
OWNER_EMAIL="owner.ZZZ@autorepairs.com"
OWNER_PASSWORD="ownerZZZ123"  # first-time password only; change it in Owner portal > Settings
# Set to true when serving over HTTPS
COOKIE_SECURE="false"

# Verification code at registration.
#   email  (default) free email codes - needs the EMAIL_* settings below
#   twilio           paid SMS (TWILIO_* below)      console  demo only (code shown on screen in dev)
OTP_PROVIDER="email"
# Free option: Brevo (300 emails/day). Create an account, verify a sender email, then SMTP & API > API keys.
EMAIL_PROVIDER="brevo"
EMAIL_API_KEY=""
EMAIL_FROM="your-verified-sender@example.com"
EMAIL_FROM_NAME="ZZZ AUTO REPAIR"
# Resend instead: EMAIL_PROVIDER="resend" (free tier needs a verified domain to email other people)
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_VERIFY_SID=""
# DEMO ONLY: shows the code on screen even in production (anyone could verify any email). Remove for real use.
# OTP_SHOW_CODE="true"

# Public site address used in shared bill links (optional; detected automatically)
# APP_URL="https://your-site.vercel.app"

# ── Stripe Card Payments (Sandbox / Test mode) ──────────────────────────────
# Card data NEVER touches your server — Stripe Checkout hosts all card fields.
# No card numbers, CVV, or PAN are ever saved to your database.
#
# 1. Sign up free at https://stripe.com
# 2. Go to https://dashboard.stripe.com/test/apikeys
# 3. Copy your Test Secret Key (sk_test_...) and Publishable Key (pk_test_...)
# STRIPE_SECRET_KEY="sk_test_YOUR_SECRET_KEY_HERE"
# STRIPE_PUBLISHABLE_KEY="pk_test_YOUR_PUBLISHABLE_KEY_HERE"
#
# Webhook signature verification (prevents forged payment events in production):
# Install Stripe CLI: https://stripe.com/docs/stripe-cli
# Run: stripe listen --forward-to localhost:3000/api/stripe-webhook
# Paste the whsec_... shown:
# STRIPE_WEBHOOK_SECRET="whsec_YOUR_WEBHOOK_SECRET_HERE"
#
# Test card numbers (sandbox only — these never charge real money):
#   4242 4242 4242 4242  — Visa, any future date, any CVC
#   5555 5555 5555 4444  — Mastercard
#   4000 0000 0000 9995  — Declined card (for testing error handling)

# ── Garage details, tax and timezone ───────────────────────────────────────
# NEXT_PUBLIC_GARAGE_NAME="ZZZ Auto Repair"
# NEXT_PUBLIC_GARAGE_PHONE="+1 555 123 4567"
# NEXT_PUBLIC_GARAGE_EMAIL="hello@yourgarage.com"
# NEXT_PUBLIC_GARAGE_ADDRESS="123 Main St, City, ST"
# NEXT_PUBLIC_TIMEZONE="America/New_York"
# TAX_PCT="0"
# Set to true to require an email code at registration (needs EMAIL_* above)
# REQUIRE_VERIFICATION="true"

# ── Google sign-in (customers only) ────────────────────────────────────────
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
